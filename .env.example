# Generate two DIFFERENT random secrets, e.g. openssl rand -hex 32.
# Never commit the filled .env file. The CLI does not load it automatically.
RELAY_API_TOKEN=
RELAY_SIGNING_SECRET=
RELAY_DB=./data/relaykit.db
RELAY_ADDR=127.0.0.1:8080
# Enable ONLY for the local flaky receiver demo.
RELAY_ALLOW_LOCAL_DEMO=false
